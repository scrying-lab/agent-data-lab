{
  "name": "agent-data-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "vite build && node scripts/bundle-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "e2e": "playwright test",
    "scan": "node scripts/public-safety.mjs",
    "scan:generic": "node scripts/public-safety.mjs --generic-only",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run scan:generic",
    "record": "node --import tsx agent/record.ts",
    "record:governance": "node --import tsx agent/record-governance.ts",
    "eval": "node --import tsx evaluation/run.ts",
    "record:bedrock": "node --import tsx agent/bedrock.ts"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@observablehq/plot": "0.6.19",
    "@strands-agents/sdk": "1.24.0",
    "@xyflow/react": "12.12.1",
    "arquero": "8.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "json5": "2.2.3",
    "lucide-react": "1.70.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@smithy/node-http-handler": "4.14.2",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
